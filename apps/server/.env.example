# WP Starter shared builder server — configuration example.
#
# Copy to apps/server/.env for local use, or to /etc/wp-starter/server.env on a
# server (mode 640, owned by root). Real environment variables always win over
# this file, so systemd/container settings are authoritative.

# ---------------------------------------------------------------- required ---
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
WP_STARTER_SESSION_SECRET=

# ---------------------------------------------------------------- database ---
# PostgreSQL in production. SQLite (`sqlite:/var/lib/wp-starter/server.sqlite`)
# is supported for local development and single-user setups.
WP_STARTER_DATABASE_URL=postgres://wp_starter:change-me@127.0.0.1:5432/wp_starter
# Set to true when the database requires TLS (most managed providers do).
WP_STARTER_DATABASE_SSL=false

# ------------------------------------------------------------- shared store ---
# The one canonical builder-core library directory shared by every account.
WP_STARTER_DATA_DIR=/var/lib/wp-starter

# ----------------------------------------------------------------- network ---
# Keep 127.0.0.1 behind a reverse proxy; nginx terminates TLS.
WP_STARTER_SERVER_HOST=127.0.0.1
WP_STARTER_SERVER_PORT=47900
# Public URL. `https://` here also enables Secure cookies and HSTS.
WP_STARTER_BASE_URL=https://builder.example.com
# Trust X-Forwarded-For for the recorded session IP. Enable only behind nginx.
WP_STARTER_TRUST_PROXY=true
# Leave false for https base URLs unless TLS is terminated elsewhere.
WP_STARTER_SECURE_COOKIES=

# --------------------------------------------------------------- accounts ---
# Closed by default: clients join only through an admin-issued invite code.
WP_STARTER_ALLOW_OPEN_REGISTRATION=false
# Optional one-time administrator, created on first boot only.
WP_STARTER_ADMIN_EMAIL=
WP_STARTER_ADMIN_PASSWORD=
# How long a signed-in session stays valid (default 336 hours = 14 days).
WP_STARTER_SESSION_TTL_HOURS=336

# ---------------------------------------------------------------- limits ----
# Per-account ceiling across packages, snapshots, and build artifacts.
WP_STARTER_ACCOUNT_QUOTA_BYTES=20971520
# Largest single upload. Keep nginx `client_max_body_size` above this.
WP_STARTER_MAX_UPLOAD_BYTES=1048576
WP_STARTER_MAX_JSON_BYTES=8388608
# Refuse new uploads/builds below this much free space in the shared store.
WP_STARTER_MIN_FREE_BYTES=2097152

# ---------------------------------------------------------------- builds ----
# 1–2 workers; the cap keeps concurrent ZIP builds from exhausting memory.
WP_STARTER_BUILD_WORKERS=2
# Delete finished builds (and their artifacts) after this many hours.
WP_STARTER_BUILD_RETENTION_HOURS=720

# ------------------------------------------------------------------ logs ----
# quiet | info | debug
WP_STARTER_LOG_LEVEL=info
