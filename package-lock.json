    },
    "node_modules/@wp-starter/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/@wp-starter/gui": {
      "resolved": "apps/gui",
      "link": true
    },
    "node_modules/@types/node": {
      "version": "22.15.0",
      "license": "MIT",
      "dependencies": {
        "undici-types": "~6.21.0"
      }
    },
    "node_modules/typescript": {
      "version": "5.8.3",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "node_modules/undici-types": {
      "version": "6.21.0",
      "license": "MIT"
    }
