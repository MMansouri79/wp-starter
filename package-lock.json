{
  "name": "wp-starter-system",
  "version": "0.1.0-alpha.22",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "wp-starter-system",
      "version": "0.1.0-alpha.22",
      "workspaces": ["apps/*", "packages/*"],
      "engines": {"node": ">=20"},
      "devDependencies": {
        "@types/node": "22.15.0",
        "typescript": "5.8.3"
      }
    },
    "apps/cli": {
      "name": "@wp-starter/cli",
      "version": "0.1.0-alpha.22"
    },
    "apps/gui": {
      "name": "@wp-starter/gui",
      "version": "0.1.0-alpha.22"
    },
    "packages/builder-core": {
      "name": "@wp-starter/builder-core",
